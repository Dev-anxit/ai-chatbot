# ─────────────────────────────────────────────────────
# Ehan AI Backend — Environment Variables
# ─────────────────────────────────────────────────────

# PRIMARY AI PROVIDER — Google Gemini
# Get yours at https://aistudio.google.com/apikey
GEMINI_API_KEY=

# SECONDARY FALLBACK — Groq (Fast inference)
# Get yours at https://console.groq.com
GROQ_API_KEY=

# OPTIONAL — OpenAI (if you have quota)
OPENAI_API_KEY=

# OPTIONAL — NewsAPI for RAG real-time context
# Get yours at https://newsapi.org
NEWSAPI_KEY=

# OPTIONAL — HuggingFace token for faster model downloads
HF_TOKEN=

# Keep-alive interval in seconds (default: 600 = 10 min)
# Prevents Render free tier from sleeping
KEEP_ALIVE_INTERVAL=600
