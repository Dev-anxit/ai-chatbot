# Ehan AI — Node Backend Environment Variables
# Copy this file to .env and fill in your keys

PORT=8000

# Primary AI Provider (get one at https://aistudio.google.com/apikey)
GEMINI_API_KEY=your_gemini_api_key_here

# Fallback AI Provider (get one at https://console.groq.com)
GROQ_API_KEY=your_groq_api_key_here

# Optional: MongoDB connection string for chat history persistence
MONGODB_URI=

NODE_ENV=development
