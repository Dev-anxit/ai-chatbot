{
  "version": 2,
  "installCommand": "cd frontend/chat-ui && npm install",
  "buildCommand": "cd frontend/chat-ui && npm run build",
  "outputDirectory": "frontend/chat-ui/dist",
  "rewrites": [
    { "source": "/chat/:path*", "destination": "/api/chat/:path*" },
    { "source": "/((?!api|chat).*)", "destination": "/index.html" }
  ]
}
