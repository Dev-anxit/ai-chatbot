# Ehan AI — Vite Frontend Environment Variables
# Copy this file to .env and fill in your keys

# Backend API URL (set to your deployed backend URL in production)
VITE_API_BASE="http://localhost:8000"

# Firebase Configuration (for authentication & chat history)
VITE_FIREBASE_API_KEY="your_firebase_api_key"
VITE_FIREBASE_AUTH_DOMAIN="your-app.firebaseapp.com"
VITE_FIREBASE_PROJECT_ID="your-project-id"
VITE_FIREBASE_STORAGE_BUCKET="your-app.firebasestorage.app"
VITE_FIREBASE_MESSAGING_SENDER_ID="000000000000"
VITE_FIREBASE_APP_ID="1:000000000000:web:xxxxxxxxxxxx"
